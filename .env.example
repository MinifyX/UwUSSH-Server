# How your devices reach this server: a name or an address, with the port. nas.lan:8443,
# 192.168.1.20:8443 or a Tailscale name all work. It goes into the setup code and the certificate.
# Behind a reverse proxy it is the https address the proxy answers on: https://sync.example.com
UWUSSH_PUBLIC=nas.lan:8443

# Image tag: latest (stable releases), beta (every release), edge (every commit on main)
# or an exact version like 0.1.0. sudo bash update.sh --version <tag> switches it.
UWUSSH_VERSION=latest

# Where the server listens on this machine: a port, or an address:port like 127.0.0.1:8443.
# install.sh looks before it starts and asks when 8443 is taken.
UWUSSH_BIND=8443

# Who may make an account: invite (with a code from `uwussh-server invite`; the first start
# prints one), open (anyone who reaches the server) or closed (nobody new).
UWUSSH_REGISTRATION=invite

# auto: the server makes its own certificate, and your devices pin its fingerprint the way an
# SSH client pins a host key. off: a reverse proxy in front does TLS. Then set
# UWUSSH_TRUST_FORWARDED=on as well, so the rate limits count devices and not the proxy, and
# only then: anyone can send that header to a server that believes it.
UWUSSH_TLS=auto
UWUSSH_TRUST_FORWARDED=off

# Once a day the server asks GitHub whether there is a newer release, and says so in its log.
# It is the only connection the server opens on its own; off stops it.
UWUSSH_UPDATE_CHECK=on

# How many accounts the server takes, and what one account may hold. A vault of hosts, keys and
# snippets is a few megabytes; these leave room for a hundred times that.
#UWUSSH_MAX_ACCOUNTS=100
#UWUSSH_ACCOUNT_MAX_RECORDS=100000
#UWUSSH_ACCOUNT_MAX_MB=256
